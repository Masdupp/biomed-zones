# Copy to .env. Every variable has a working default for the offline demo.

# --- Database ---
POSTGRES_USER=biomed
POSTGRES_PASSWORD=biomed
POSTGRES_DB=biomed
DATABASE_URL=postgresql://biomed:biomed@localhost:5432/biomed

# --- API ---
API_PORT=3001
# Generate with: openssl rand -hex 32  (the defaults are for local demo only)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
ML_SERVICE_URL=http://localhost:8001

# --- ML service ---
ML_PORT=8001
ML_ADMIN_TOKEN=dev-ml-admin-token-change-me

# --- Live ingestion (optional; without these the pipeline uses data/snapshot) ---
# Free account: https://data.marine.copernicus.eu/register
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
